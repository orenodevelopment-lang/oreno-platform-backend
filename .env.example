# =============================================================================
# Oreno backend environment template
# Copy to `.env` for local development. NEVER commit a real `.env`.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Process name used in structured logs: api | worker
SERVICE_NAME=oreno-api
LOG_LEVEL=info

# --- URLs -------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Comma-separated exact origins. Wildcards are rejected in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL=postgresql://oreno:oreno@localhost:5432/oreno?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=postgresql://oreno:oreno@localhost:5432/oreno?schema=public
DATABASE_POOL_MAX=10

# --- Key Value (Redis protocol) ---------------------------------------------
KEY_VALUE_URL=redis://localhost:6379
KEY_VALUE_TLS=false
QUEUE_PREFIX=oreno

# --- Sessions and secrets ---------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_COOKIE_NAME=oreno_session
# Optional shared parent domain (for example .oreno.example) when the web app
# and API use sibling hosts and the browser must send the same cookies to both.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=10080
CSRF_COOKIE_NAME=oreno_csrf
CSRF_HEADER_NAME=x-oreno-csrf

# --- Identity provider ------------------------------------------------------
# baseline = Oreno-managed email/password + OAuth (default)
IDENTITY_PROVIDER=baseline
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=oreno-api

# Google OAuth (optional locally; leave blank to disable the provider).
# A provider is all-or-nothing: either set all three of ID, SECRET and
# REDIRECT_URI, or leave all three blank. Setting only the redirect URI fails
# startup validation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LinkedIn OAuth (optional locally; leave blank to disable the provider)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Exact redirect allowlist for post-authentication frontend redirects.
AUTH_REDIRECT_ALLOWLIST=http://localhost:3000/auth/callback

# --- Email ------------------------------------------------------------------
# log | capture | smtp | ses | resend
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@oreno.local
EMAIL_FROM_NAME=Oreno
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_PROVIDER_API_KEY=
# Directory used by the `capture` adapter to write rendered emails.
EMAIL_CAPTURE_DIR=tmp/emails

# --- Object storage ---------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=tmp/storage
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=oreno-public-local
S3_PRIVATE_BUCKET=oreno-private-local
S3_QUARANTINE_BUCKET=oreno-quarantine-local
S3_EXPORT_BUCKET=oreno-exports-local
S3_FORCE_PATH_STYLE=false
# Optional endpoint override for local S3-compatible services (e.g. MinIO).
S3_ENDPOINT=
PRESIGNED_UPLOAD_TTL_SECONDS=900
PRESIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400

# --- CloudFront -------------------------------------------------------------
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key. Use literal \n escapes in a single-line env var.
CLOUDFRONT_PRIVATE_KEY=

# --- Malware scanning -------------------------------------------------------
# none (local/test only) | clamav
MALWARE_SCANNER=none
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
APPLICATION_RATE_LIMIT_MAX=30
MESSAGE_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=60
REPLACEMENT_WINDOW_DAYS=90

# --- Observability ----------------------------------------------------------
ERROR_MONITORING_DSN=
METRICS_ENABLED=true
# Used only by `npm run verify:providers -- --live` to send a controlled probe.
PROVIDER_TEST_EMAIL_TO=
# Optional known public object key for an additional CloudFront download probe.
PROVIDER_TEST_CLOUDFRONT_OBJECT_KEY=

# --- Platform administration ------------------------------------------------
# Comma-separated bootstrap platform-admin emails. Used only by the seed script.
PLATFORM_ADMIN_EMAILS=
# TOTP issuer label shown in authenticator apps.
TOTP_ISSUER=Oreno Platform
